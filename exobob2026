    async function saveHtml(){let source;try{source=portableHtml()}catch(_){setStudioNotice('Could not build the updated HTML.');return}const blob=new Blob([source],{type:'text/html'});if('showSaveFilePicker' in window){try{const handle=await showSaveFilePicker({suggestedName:'Gustavo_Rodriguez_Portfolio.html',types:[{description:'HTML document',accept:{'text/html':['.html']}}]});const writable=await handle.createWritable();await writable.write(blob);await writable.close();state.dirty=false;syncSaveLabel();setStudioNotice('HTML saved with the current portfolio data.');return}catch(error){if(error&&error.name==='AbortError'){setStudioNotice('Save cancelled.');return}}}const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='Gustavo_Rodriguez_Portfolio.html';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);state.dirty=false;syncSaveLabel();setStudioNotice('Updated HTML downloaded. Replace the older copy with this file.')}

    document.addEventListener('click',event=>{const route=event.target.closest('[data-route]');if(route){setRoute(route.dataset.route,true);if(route.dataset.anchor==='bakery'){history.replaceState(null,'','#about/bakery');requestAnimationFrame(()=>document.getElementById('bakery').scrollIntoView({block:'start'}))}return}const project=event.target.closest('[data-project-index]');if(project){openProject(project.dataset.projectCategory,Number(project.dataset.projectIndex),project,true);return}const filter=event.target.closest('[data-filter]');if(filter){state.filters[filter.dataset.filterCategory]=filter.dataset.filter;renderCategory(filter.dataset.filterCategory);return}const tab=event.target.closest('[data-case-tab]');if(tab){selectCaseTab(tab.dataset.caseTab);return}const media=event.target.closest('[data-media-index]');if(media){openMedia(Number(media.dataset.mediaIndex));return}const find=event.target.closest('[data-find-index]');if(find){document.getElementById('finderDialog').close();unlockScroll();setRoute(categoryToRoute[find.dataset.findCategory],true);openProject(find.dataset.findCategory,Number(find.dataset.findIndex),find,true);return}const studioTab=event.target.closest('[data-studio-tab]');if(studioTab){state.studioTab=studioTab.dataset.studioTab;renderStudio();return}const edit=event.target.closest('[data-edit-action]');if(edit){handleEditAction(edit.dataset.editAction,Number(edit.dataset.editIndex),edit.dataset.editCategory||'');return}const remove=event.target.closest('[data-remove-media]');if(remove){pendingGallery.splice(Number(remove.dataset.removeMedia),1);renderPendingGallery();return}});
