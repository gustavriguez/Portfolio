    const DEFAULT_PORTFOLIO_DATA = /*PORTFOLIO_DATA_START*/{"categoryMeta":{"manufacturing":{"eyebrow":"Work / Manufacturing & Reliability","title":"Manufacturing & Reliability","intro":"Reliability investigations, maintenance systems, Lean improvement, facilities planning, field support, and regulated engineering documentation completed at Lonza.","index":"01"},"robotics":{"eyebrow":"Projects / Design, Build & Control","title":"Projects & Systems","intro":"Robotics, mechatronics, CAD, fabrication, embedded control, simulation, software, and technical program leadership.","index":"02"},"biomechanics":{"eyebrow":"Research / Human Motion","title":"Research & Human Motion","intro":"Human-motion measurement, assistive technology, experimental planning, literature review, validation, and responsible human-subject research preparation.","index":"03"}},"portfolioProjects":{"manufacturing":[{"title":"Xcelodose 600S & Microbalance Reliability Investigation","status":"Active reliability investigation","summary":"Investigated recurring Xcelodose and microbalance failures as a mechanical-reliability problem centered on load cells, springs, corner-load performance, alignment, and weigh-pan interaction.","details":["Compared four microbalance units with different mechanical, calibration, and communication failure indicators.","Observed manufacturing operation and compared cleaning practices with Product Development equipment.","Performed equipment alignments and developed documentation, status-communication, and recurrence-prevention improvements."],"methods":["6M","Gemba observation","Equipment inspection","SOP review","Mechanical alignment"],"featured":true},{"title":"S.M.U.R.F. — Shared Maintenance Urgent Request Form","status":"Active development","summary":"Developed a two-app maintenance-request ecosystem for structured intake, automated prioritization, assignment, work-order tracking, reminders, searchable records, and closeout.","details":["Built separate request-submission and maintenance-assignment experiences in Microsoft Power Apps.","Structured branch-specific intake for equipment, utilities, safety, quality, and controls-related symptoms without claiming industrial-controls programming.","Designed urgency sorting, status and building filters, searchable IDs, HTML notifications, and reminder logic for unassigned work."],"methods":["Power Apps","Power Automate","SharePoint","Microsoft Lists","Decision-tree logic"],"featured":true},{"title":"Automated Cleaning Validation Sorting & Status System","status":"Prototype · Tested","summary":"Designed a low-friction QR and Microsoft Forms workflow that calculates cleaning readiness from elapsed time and presents green, yellow, or red status on a visual dashboard.","details":["Green indicates 0–10 days, yellow 11–30 days, and red 31 or more days since cleaning.","The workflow supports date capture, sorting, traceability, readiness visibility, and follow-up identification."],"methods":["QR codes","Microsoft Forms","Date logic","Power Apps","Visual management"],"featured":true},{"title":"New Manufacturing Process Tracker","status":"Prototype · Active development","summary":"Designed a separate manufacturing tracker to clarify room, batch, operator, status, and process state while reducing incomplete or incorrect entries through guided inputs.","details":["Supports multiple rooms and simultaneous batches, batch lookup, operator tracking, pause reasons, and downtime urgency.","Includes shift handoff, persistent timestamped notes, archive records, role-controlled actions, and reporting integration concepts.","Kept this newer tracker separate from earlier SQUID-related work and did not invent an expansion for SQUID."],"methods":["Visual management","Poka-yoke","Power Apps","Data architecture","Workflow design"],"featured":true},{"title":"Equipment & Dedicated Parts Tracking","status":"System development","summary":"Developed a broader equipment and dedicated-parts information system covering searchable records, cleaning history, readiness, follow-up actions, and dashboard visibility.","details":["Connected equipment records with dedicated manufacturing-part information and cleaning-status history.","Designed for rapid lookup across Power Apps, Power BI, Excel, and Microsoft Lists or SharePoint."],"methods":["Power Apps","Power BI","Excel","Microsoft Lists","SharePoint"]},{"title":"5S Asset Labeling & Search-Time Reduction","status":"Completed","summary":"Applied 5S and visual management to asset identification, record cleanup, storage alignment, and standardized labeling, reducing measured physical asset search time by approximately 83%.","details":["Before-and-after trials reduced a representative search from roughly 9 minutes to 1.5 minutes.","Reviewed label printers and materials including Brady M510, Zebra ZD421d, and multiple Brady label stocks."],"methods":["A3","5S","Visual management","Time study","Asset records"],"featured":true},{"title":"Engineering & Maintenance Handbook","status":"Completed · Quality approved","summary":"Created a linked technician-onboarding and training resource covering safety, GMP behavior, work preparation, execution, testing, documentation, closeout, escalation, turnover, contractors, and KPIs.","details":["Converted technician SOP content into the practical workflow Receive → Prepare → Execute → Test → Document → Close.","Presented the material to management, incorporated feedback, and received Quality approval for standardized onboarding."],"methods":["Training design","SOP synthesis","Workflow mapping","GMP/GDP","Controlled documentation"]},{"title":"Five-Year Capital Projection & Sustaining Plan","status":"Completed · Advanced planning","summary":"Supported a first-pass five-year plan for major laboratory, warehouse, building, infrastructure, utility, and facility assets using condition, cost, risk, ownership, and recommended action.","details":["Organized work into Asset Sustaining, Opportunity, and Compliance categories.","Connected asset condition and projected needs to reliability, compliance, business continuity, and facility capability."],"methods":["Excel","Lifecycle planning","Risk-based prioritization","Capital planning","Asset review"]},{"title":"Air-Chiller Lifecycle Study","status":"Completed","summary":"Inspected air chillers and translated physical condition into lifecycle records, reliability concerns, monitoring needs, and future maintenance or replacement planning.","details":["Connected current operating condition with asset aging, future reliability, and business risk."],"methods":["Field inspection","HVAC utilities","Excel","Lifecycle analysis","Risk assessment"]},{"title":"Contractor & Facility Modification Coordination","status":"Completed · Field support","summary":"Supported an external concrete-cutting project that created space for a new dock through facility access, site coordination, requirements, contractor interaction, and execution support.","methods":["Facilities engineering","Scope coordination","Contractor support","Site logistics"]},{"title":"Water Leak CAPA & Procedure Update","status":"Completed · Quality support","summary":"Supported review of a water-leak and packaging issue that led to a procedure change from an air flush to nitrogen, with corrective-action and documentation follow-up.","methods":["CAPA support","Procedure review","Technical documentation","Packaging process"]},{"title":"Preventive Maintenance, HVAC & Utilities Support","status":"Completed · Field exposure","summary":"Supported preventive maintenance, equipment checks, HVAC and air-handling work, inspections, troubleshooting, work orders, and technician activities in a controlled manufacturing facility.","methods":["Preventive maintenance","HVAC/AHU","Utilities","Inspections","Work orders"]},{"title":"Quality-System Engineering & Validation Support","status":"Completed · Technical exposure","summary":"Worked with controlled engineering records and gained exposure to cha