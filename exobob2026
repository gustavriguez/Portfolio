    async function compressImage(file,maxWidth=1800,maxHeight=1400){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onerror=reject;reader.onload=()=>{const img=new Image();img.onerror=reject;img.onload=()=>{const ratio=Math.min(1,maxWidth/img.width,maxHeight/img.height);const canvas=document.createElement('canvas');canvas.width=Math.round(img.width*ratio);canvas.height=Math.round(img.height*ratio);canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/webp',.84))};img.src=reader.result};reader.readAsDataURL(file)})}

