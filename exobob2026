      ['gatewayGrid','featuredCases','manufacturingGrid','roboticsGrid','biomechanicsGrid','experienceTimeline','educationCard','credentialGroups','skills','studioPanel','editFields','caseMedia','caseEvidence','caseDetails','caseSpecs','caseMethods','caseProof','finderResults','lightboxMedia'].forEach(id=>{const el=root.querySelector('#'+id);if(el)el.innerHTML=''});
