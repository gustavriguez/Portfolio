    document.getElementById('editorLogin').addEventListener('submit',event=>{event.preventDefault();if(document.getElementById('editorPassword').value===PASSWORD){sessionStorage.setItem(SESSION_KEY,'yes');document.getElementById('editorPassword').value='';syncStudioAccess()}else document.getElementById('editorLoginMessage').textContent='Incorrect password.'});
