ue.trim(),expected:document.getElementById('editExpected').value.trim(),skills:splitLines(document.getElementById('editSkills').value),headshotHorizontal:pendingProfileMedia?.headshotHorizontal||PORTFOLIO_DATA.profile.headshotHorizontal,headshotVertical:pendingProfileMedia?.headshotVertical||PORTFOLIO_DATA.profile.headshotVertical})}document.getElementById('editDialog').close();saveDraft('Changes saved. Use Save HTML when finished.')});
    document.getElementById('saveHtml').addEventListener('click',saveHtml);document.getElementById('exportJson').addEventListener('click',()=>{const blob=new Blob([JSON.stringify(PORTFOLIO_DATA,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='Gustavo_Rodriguez_Portfolio_Backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);setStudioNotice('JSON backup downloaded.')});document.getElementById('importJson').addEventListener('click',()=>document.getElementById('importFile').click());document.getElementById('importFile').addEventListener('change',event=>{const file=event.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const incoming=JSON.parse(reader.result);if(!incoming.portfolioProjects||!incoming.profile)throw new Error();PORTFOLIO_DATA=applyFrontPageUpdate(incoming);saveDraft('Backup imported.')}catch(_){setStudioNotice('That file is not a valid portfolio backup.')}};reader.readAsText(file)});document.getElementById('resetData').addEventListener('click',()=>{if(confirm('Reset every edit to the portfolio included in this HTML file?')){PORTFOLIO_DATA=deepClone(DEFAULT_PORTFOLIO_DATA);try{localStorage.removeItem(STORAGE_KEY)}catch(_){}state.dirty=false;renderAll();setStudioNotice('Reset to the included portfolio.')}});
