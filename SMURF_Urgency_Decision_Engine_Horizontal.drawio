p;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="936" y="158" width="276" height="122" as="geometry"/></mxCell><mxCell id="13" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#0B66B2;fontFamily=Arial;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="948" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="9" target="12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Questions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Answer selected&lt;br&gt;concern questions&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1234" y="158" width="276" height="122" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#0B66B2;fontFamily=Arial;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1246" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="12" target="15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;Request details&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Room, asset,&lt;br&gt;summary,&lt;br&gt;attachments&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1532" y="158" width="276" height="122" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#0B66B2;fontFamily=Arial;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1544" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="15" target="18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="21" value="&lt;b&gt;Review / submit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Confirm findings&lt;br&gt;and submit&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1830" y="158" width="276" height="122" as="geometry"/></mxCell><mxCell id="22" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#0B66B2;fontFamily=Arial;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1842" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="18" target="21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="24" value="Concern groups: Equipment / Mechanical  |  Utilities / Facilities  |  Safety / EHS  |  Quality / Process Impact  |  Controls / Electrical / Automation    •    Office / General Area is supplemental logic, not a sixth concern." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="292" width="2090" height="36" as="geometry"/></mxCell><mxCell id="25" value="02 &amp;nbsp;&amp;nbsp; URGENCY DECISION ENGINE" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=0;fillColor=#0B66B2;fontFamily=Arial;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="2140" height="52" as="geometry"/></mxCell><mxCell id="26" value="&lt;b&gt;Block navigation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Notify the requester and remain on the current screen until every required question is answered." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="425" width="390" height="125" as="geometry"/></mxCell><mxCell id="27" value="&lt;b&gt;IMMEDIATE HARD OVERRIDES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Production&lt;/b&gt;&lt;br&gt;GEN-03, MECH-02, QUAL-01, QUAL-07&lt;br&gt;&lt;br&gt;&lt;b&gt;Immediate danger&lt;/b&gt;&lt;br&gt;GEN-04, SAFE-08, SAFE-05&lt;br&gt;&lt;br&gt;&lt;b&gt;Facility catastrophic&lt;/b&gt;&lt;br&gt;MECH-03, UTI-01, UTI-06, UTI-05*, UTI-08&lt;br&gt;&lt;br&gt;&lt;b&gt;Test:&lt;/b&gt; Any applicable Answer = Yes AND ImmediateFlag = true&lt;br&gt;* UTI-05 is Immediate only for NonOffice scope with an area value." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="570" width="390" height="275" as="geometry"/></mxCell><mxCell id="28" value="&lt;b&gt;SAME-SHIFT COMBINATIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule A - one direct Yes&lt;/b&gt;&lt;br&gt;GEN-02, GEN-06, MECH-01, MECH-04, MECH-08, CTRL-01, CTRL-03, CTRL-04, CTRL-05, CTRL-06, SAFE-02, SAFE-03, SAFE-04, SAFE-06, SAFE-07, QUAL-03, QUAL-04, QUAL-06, QUAL-08, OFF-01, OFF-02, OFF-08, OFF-09&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule B - Active AND Impact&lt;/b&gt;&lt;br&gt;GEN-01 AND any of UTI-02, UTI-04, UTI-06, CTRL-02, OFF-03, OFF-04, GEN-08, MECH-09, UTI-02, UTI-04, CTRL-03, OFF-09&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule C - Recurrence AND Degradation&lt;/b&gt;&lt;br&gt;Any GEN-05, MECH-07, CTRL-08 AND any MECH-06, UTI-02, CTRL-02" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="865" width="390" height="330" as="geometry"/></mxCell><mxCell id="29" value="All required answers complete?&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;Compare active answers to applicable question-bank rows&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="425" width="600" height="145" as="geometry"/></mxCell><mxCell id="30" value="&lt;b&gt;Build the applicable answer set&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;General + selected concern + Office rows only when valueType = Office&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=16;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="690" y="610" width="340" height="90" as="geometry"/></mxCell><mxCell id="31" value="Any applicable Immediate Yes?&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;Hard override - evaluated first&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="745" width="520" height="125" as="geometry"/></mxCell><mxCell id="32" value="Any Same-Shift rule true?&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;Rule A OR Rule B OR Rule C&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="935" width="520" height="125" as="geometry"/></mxCell><mxCell id="33" value="&lt;b&gt;RULE INTERPRETATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Immediate always wins when both levels are present.&lt;br&gt;&lt;br&gt;Weights remain available for audit and analytics only; they do not add up to an urgency score." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="425" width="410" height="185" as="geometry"/></mxCell><mxCell id="34" value="&lt;b&gt;IMMEDIATE URGENCY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Highest priority. Prompt maintenance attention is required." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#F7DDDD;fontFamily=Arial;fontColor=#000000;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1690" y="690" width="430" height="125" as="geometry"/></mxCell><mxCell id="35" value="&lt;b&gt;SAME-SHIFT URGENCY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Address during the current shift. Serious, but no immediate override." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#F7EBCF;fontFamily=Arial;fontColor=#000000;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1690" y="885" width="430" height="125" as="geometry"/></mxCell><mxCell id="36" value="&lt;b&gt;NOT IMMEDIATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Required answers are complete and no Immediate or Same-Shift rule is true." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#DDEEDC;fontFamily=Arial;fontColor=#000000;fontSize=17;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1690" y="1060" width="430" height="125" as="geometry"/></mxCell><mxCell id="37" value="&lt;b&gt;NO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="462" width="60" height="34" as="geometry"/></mxCell><mxCell id="38" value="&lt;b&gt;YES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="575" width="64" height="34" as="geometry"/></mxCell><mxCell id="39" value="&lt;b&gt;YES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="772" width="64" height="34" as="geometry"/></mxCell><mxCell id="40" value="&lt;b&gt;NO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="830" y="887" width="64" height="34" as="geometry"/></mxCell><mxCell id="41" value="&lt;b&gt;YES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="958" width="64" height="34" as="geometry"/></mxCell><mxCell id="42" value="&lt;b&gt;NO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="850" y="1080" width="64" height="34" as="geometry"/></mxCell><mxCell id="43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="29" target="37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="37" target="26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="29" target="38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="38" target="30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="30" target="31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="31" target="39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="39" target="34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="31" target="40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="40" target="32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="32" target="41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="41" target="35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B66B2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="32" target="42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;