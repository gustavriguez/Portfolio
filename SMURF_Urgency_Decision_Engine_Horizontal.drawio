      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;DECISION GOVERNANCE&lt;/b&gt; &amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp; Requester answers facts only &amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp; Power Apps assigns urgency &amp;nbsp;&amp;nbsp; | &amp;nbsp;&amp;nbsp; Immediate overrides Same-Shift" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="2140" height="42" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;&lt;i&gt;SMURF&lt;/i&gt; - Smart Request Form&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#0A4F8A;strokeWidth=0;fillColor=#0A4F8A;fontFamily=Arial;fontColor=#FFFFFF;fontSize=27;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="2140" height="68" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Start request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;New maintenance&lt;br&gt;request&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFamily=Arial;fontColor=#000000;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="42" y="158" width="276" height="122" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=1;fillColor=#0B66B2;fontFamily=Arial;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="54" y="170" width="38" height="38" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Location&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Department and&lt;br&gt;building&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0B66B2;strokeWidth=2;fillColor=#FFFFFF;fontFami